# Variables d'environnement de l'API (apps/api) — valeurs d'exemple, aucune valeur réelle.
# Copier vers .env (ignoré par git) pour le développement local.
# Schéma de validation : apps/api/src/config/env.schema.ts

# development | test | staging | production (obligatoire)
NODE_ENV=development
# Port HTTP de l'API (défaut 3000)
PORT=3000
# Adresse d'écoute (défaut 0.0.0.0)
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace (défaut info)
LOG_LEVEL=info
